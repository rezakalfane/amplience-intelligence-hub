# AMPLIENCE INTELLIGENCE HUB — Next.js server-side environment configuration
# Copy to .env.local and fill in secrets locally. Never commit .env.local.
# Do not use NEXT_PUBLIC_ for any secret.

# Real Amplience inventory as the default when credentials are present.
DATA_MODE=live
# Personal access token (Dynamic Content → your profile → Personal access tokens). Used for every read.
# It carries its user's permissions: prefer a user with read-only access to the hub.
# Only https://api.amplience.net is ever called.
AMPLIENCE_PAT=
# The hub to scan: its id (preferred) or its name (the <name> in <name>.cdn.content.amplience.net).
# The name is also used for deep links into the Dynamic Content app.
AMPLIENCE_HUB_ID=
AMPLIENCE_HUB_NAME=
# Source locale. Default: the first scanned locale. Don't guess: set it.
AMPLIENCE_MASTER_LOCALE=
# Comma-separated subset of the hub's locales (Settings → Localization). Default: all hub locales.
AMPLIENCE_LOCALES=
# Comma-separated content repository names. Default: repositories that have content types and
# no item-level locale other than the master (field-level localization is what this tool reads).
AMPLIENCE_REPOSITORIES=

# Prefer a separate write token, ideally a user limited to a test repository.
# The app never uses it for reads.
AMPLIENCE_WRITE_PAT=
# Writes only ever touch these content item ids (comma-separated test items). Empty = nothing writable.
CMS_WRITE_ALLOWED_ITEM_IDS=
ENABLE_CMS_WRITES=false
ENABLE_CMS_PUBLISH=false

# Live AI proposal generation. Model MUST be verified for user's account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
AI_MAX_USD_PER_BATCH=2.00
# Prices YOU configure (USD per 1M tokens). Unset => cost shows as "—", never $0.
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
AI_SEND_CONTENT_TO_OPENAI=false

# UI demo/fixture fallback; demo and live status must always be visible.
NEXT_PUBLIC_APP_NAME=Amplience Intelligence Hub

# Scan bounds and policy
SCAN_MAX_ITEMS_PER_TYPE=200
# Locale codes as the hub spells them, e.g. fr-FR
CRITICAL_LOCALES=
HUB_ACTOR_ID=reviewer@local
